<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已添加的字符序列 (点击可删除)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <Button
                android:id="@+id/btn_clear_sequence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="清空"
                android:textSize="12sp"
                android:textColor="#FF5722"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Scrollable container for the character boxes -->
        <HorizontalScrollView
            android:id="@+id/scroll_selected_sequence"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#F5F5F5"
            android:padding="6dp"
            android:scrollbars="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/layout_selected_sequence"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"/>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点击下方按钮添加字符"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="12dp"/>

        <!-- 1. 基础字符 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="基础字符"
            android:textSize="12sp"
            android:textColor="#888888"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_type_digits"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="0-9"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_type_uppercase"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="A-Z"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_type_lowercase"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="a-z"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_type_chinese"
                    android:layout_width="0dp"
                    android:layout_weight="1.2"
                    android:layout_height="40dp"
                    android:text="中文字符"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_type_chn_digit"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="汉字/数字"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_type_chn_letter"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="汉字/字母"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_type_chn_mix"
                    android:layout_width="0dp"
                    android:layout_weight="1.2"
                    android:layout_height="40dp"
                    android:text="汉字/字母/数字"
                    android:textSize="10sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_type_chn_punct"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="中文标点"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. 中文常见单位与后缀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="中文常见单位与后缀"
            android:textSize="12sp"
            android:textColor="#888888"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_suf_prov"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="省"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_suf_city"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="市"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_suf_dist"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="区"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_suf_county"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="县"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_suf_no"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="号"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_suf_yuan"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="元"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_suf_unit"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="个"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_suf_pkg"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="件"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. 常用符号 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="常用符号"
            android:textSize="12sp"
            android:textColor="#888888"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_sym_colon"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="："
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_sym_hyphen"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="-"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_sym_asterisk"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="*"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_sym_comma"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text=","
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_sym_hash"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="#"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_sym_plus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="+"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_sym_equals"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="="
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_sym_semicolon"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text=";"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_sym_dollar"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="$"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_sym_dot"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="."
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_sym_slash"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="/"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_sym_space"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:text="空格"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_regex_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="实时预览: "
            android:textSize="14sp"
            android:textColor="#3F51B5"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

    </LinearLayout>
</ScrollView>
